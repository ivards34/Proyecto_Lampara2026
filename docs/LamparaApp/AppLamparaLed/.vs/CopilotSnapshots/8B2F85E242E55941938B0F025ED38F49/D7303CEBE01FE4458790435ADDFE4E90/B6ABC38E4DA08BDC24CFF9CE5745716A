<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pageModels="clr-namespace:AppLamparaLed.PageModels"
             xmlns:models="clr-namespace:AppLamparaLed.Models"
             xmlns:controls="clr-namespace:AppLamparaLed.Controls"
             x:Class="AppLamparaLed.Pages.HistoricoPage"
             x:DataType="pageModels:HistoricoPageModel"
             Title="Histórico">

    <Grid>
        <ScrollView>
            <VerticalStackLayout Padding="20" Spacing="20">

                <!-- Period Selector -->
                <Border StrokeShape="RoundRectangle 10" Padding="15" Background="{AppThemeBinding Light={StaticResource LightSecondaryBackground},Dark={StaticResource DarkSecondaryBackground}}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Período" FontSize="16" FontAttributes="Bold"/>
                        <Picker Title="Seleccionar período"
                                ItemsSource="{Binding Periods}"
                                SelectedItem="{Binding SelectedPeriod}"
                                HorizontalOptions="Fill"/>
                    </VerticalStackLayout>
                </Border>

                <!-- Calendar -->
                <Border StrokeShape="RoundRectangle 10" Padding="15" Background="{AppThemeBinding Light={StaticResource LightSecondaryBackground},Dark={StaticResource DarkSecondaryBackground}}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Seleccionar fecha" FontSize="16" FontAttributes="Bold"/>
                        <DatePicker Date="{Binding SelectedDate}" HorizontalOptions="Center"/>
                        <Label Text="{Binding SelectedPeriod, StringFormat='Filtrando por: {0}'}"
                               FontSize="12"
                               TextColor="{AppThemeBinding Light={StaticResource Gray500},Dark={StaticResource Gray400}}"
                               HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </Border>

                <!-- Temperature Chart -->
                <Border StrokeShape="RoundRectangle 10" Padding="15" Background="{AppThemeBinding Light={StaticResource LightSecondaryBackground},Dark={StaticResource DarkSecondaryBackground}}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Temperatura (°C)" FontSize="16" FontAttributes="Bold" HorizontalOptions="Center"/>
                        <Grid ColumnDefinitions="*,*" HorizontalOptions="Fill" ColumnSpacing="0" Padding="10,5">
                            <StackLayout Orientation="Horizontal" Spacing="8" HorizontalOptions="Start">
                                <BoxView WidthRequest="20" HeightRequest="3" Color="Red" VerticalOptions="Center"/>
                                <Label Text="Sensor" FontSize="12" VerticalOptions="Center"/>
                            </StackLayout>
                            <StackLayout Orientation="Horizontal" Spacing="8" HorizontalOptions="End" Grid.Column="1">
                                <BoxView WidthRequest="20" HeightRequest="3" Color="Blue" VerticalOptions="Center"/>
                                <Label Text="Clima" FontSize="12" VerticalOptions="Center"/>
                            </StackLayout>
                        </Grid>
                        <Grid ColumnDefinitions="45,*" RowDefinitions="28.5,41.9,41.9,41.9,41.9,3.9" ColumnSpacing="5" HeightRequest="200" VerticalOptions="Start">
                            <!-- Y-Axis Labels aligned with the chart plot area -->
                            <Label Grid.Row="0" Text="{Binding TemperatureYAxisLabels[0]}" FontSize="9" HorizontalTextAlignment="End" VerticalTextAlignment="Center"/>
                            <Label Grid.Row="1" Text="{Binding TemperatureYAxisLabels[1]}" FontSize="9" HorizontalTextAlignment="End" VerticalTextAlignment="Center"/>
                            <Label Grid.Row="2" Text="{Binding TemperatureYAxisLabels[2]}" FontSize="9" HorizontalTextAlignment="End" VerticalTextAlignment="Center"/>
                            <Label Grid.Row="3" Text="{Binding TemperatureYAxisLabels[3]}" FontSize="9" HorizontalTextAlignment="End" VerticalTextAlignment="Center"/>
                            <Label Grid.Row="4" Text="{Binding TemperatureYAxisLabels[4]}" FontSize="9" HorizontalTextAlignment="End" VerticalTextAlignment="Center"/>

                            <!-- Chart -->
                            <controls:DualLineChartView 
                                Grid.Column="1"
                                Grid.RowSpan="6"
                                SensorData="{Binding TemperatureSensorData}"
                                ApiData="{Binding TemperatureApiData}"
                                Labels="{Binding TimeLabels}"
                                Unit="°C"
                                HeightRequest="200"
                                HorizontalOptions="Fill"/>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Humidity Chart -->
                <Border StrokeShape="RoundRectangle 10" Padding="15" Background="{AppThemeBinding Light={StaticResource LightSecondaryBackground},Dark={StaticResource DarkSecondaryBackground}}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Humedad (%)" FontSize="16" FontAttributes="Bold" HorizontalOptions="Center"/>
                        <Grid ColumnDefinitions="*,*" HorizontalOptions="Fill" ColumnSpacing="0" Padding="10,5">
                            <StackLayout Orientation="Horizontal" Spacing="8" HorizontalOptions="Start">
                                <BoxView WidthRequest="20" HeightRequest="3" Color="Red" VerticalOptions="Center"/>
                                <Label Text="Sensor" FontSize="12" VerticalOptions="Center"/>
                            </StackLayout>
                            <StackLayout Orientation="Horizontal" Spacing="8" HorizontalOptions="End" Grid.Column="1">
                                <BoxView WidthRequest="20" HeightRequest="3" Color="Blue" VerticalOptions="Center"/>
                                <Label Text="Clima" FontSize="12" VerticalOptions="Center"/>
                            </StackLayout>
                        </Grid>
                        <Grid ColumnDefinitions="45,*" RowDefinitions="28.5,41.9,41.9,41.9,41.9,3.9" ColumnSpacing="5" HeightRequest="200" VerticalOptions="Start">
                            <!-- Y-Axis Labels aligned with the chart plot area -->
                            <Label Grid.Row="0" Text="{Binding HumidityYAxisLabels[0]}" FontSize="9" HorizontalTextAlignment="End" VerticalTextAlignment="Center"/>
                            <Label Grid.Row="1" Text="{Binding HumidityYAxisLabels[1]}" FontSize="9" HorizontalTextAlignment="End" VerticalTextAlignment="Center"/>
                            <Label Grid.Row="2" Text="{Binding HumidityYAxisLabels[2]}" FontSize="9" HorizontalTextAlignment="End" VerticalTextAlignment="Center"/>
                            <Label Grid.Row="3" Text="{Binding HumidityYAxisLabels[3]}" FontSize="9" HorizontalTextAlignment="End" VerticalTextAlignment="Center"/>
                            <Label Grid.Row="4" Text="{Binding HumidityYAxisLabels[4]}" FontSize="9" HorizontalTextAlignment="End" VerticalTextAlignment="Center"/>

                            <!-- Chart -->
                            <controls:DualLineChartView 
                                Grid.Column="1"
                                Grid.RowSpan="6"
                                SensorData="{Binding HumiditySensorData}"
                                ApiData="{Binding HumidityApiData}"
                                Labels="{Binding TimeLabels}"
                                Unit="%"
                                HeightRequest="200"
                                HorizontalOptions="Fill"/>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Loading Indicator -->
        <ActivityIndicator IsRunning="{Binding IsLoading}"
                           IsVisible="{Binding IsLoading}"
                           Color="{StaticResource Primary}"
                           VerticalOptions="Center"
                           HorizontalOptions="Center"/>
    </Grid>

</ContentPage>
