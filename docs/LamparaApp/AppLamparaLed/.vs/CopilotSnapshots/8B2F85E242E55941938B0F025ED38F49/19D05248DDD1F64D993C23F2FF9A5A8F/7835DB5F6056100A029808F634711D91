using SkiaSharp;
using SkiaSharp.Views.Maui;
using SkiaSharp.Views.Maui.Controls;

namespace AppLamparaLed.Controls;

public class DualLineChartView : SKCanvasView
{
    private List<double> _sensorData = new();
    private List<double> _apiData = new();
    private List<string> _labels = new();

    public static readonly BindableProperty SensorDataProperty =
        BindableProperty.Create(
            nameof(SensorData), 
            typeof(List<double>), 
            typeof(DualLineChartView),
            new List<double>(), 
            BindingMode.OneWay,
            propertyChanged: OnDataPropertyChanged);

    public static readonly BindableProperty ApiDataProperty =
        BindableProperty.Create(
            nameof(ApiData), 
            typeof(List<double>), 
            typeof(DualLineChartView),
            new List<double>(),
            BindingMode.OneWay,
            propertyChanged: OnDataPropertyChanged);

    public static readonly BindableProperty LabelsProperty =
        BindableProperty.Create(
            nameof(Labels), 
            typeof(List<string>), 
            typeof(DualLineChartView),
            new List<string>(),
            BindingMode.OneWay,
            propertyChanged: OnDataPropertyChanged);

    public List<double> SensorData
    {
        get => (List<double>)GetValue(SensorDataProperty) ?? new();
        set => SetValue(SensorDataProperty, value);
    }

    public List<double> ApiData
    {
        get => (List<double>)GetValue(ApiDataProperty) ?? new();
        set => SetValue(ApiDataProperty, value);
    }

    public List<string> Labels
    {
        get => (List<string>)GetValue(LabelsProperty) ?? new();
        set => SetValue(LabelsProperty, value);
    }

    private static void OnDataPropertyChanged(BindableObject bindable, object oldValue, object newValue)
    {
        if (bindable is DualLineChartView chartView)
        {
            chartView._sensorData = chartView.SensorData ?? new();
            chartView._apiData = chartView.ApiData ?? new();
            chartView._labels = chartView.Labels ?? new();
            chartView.InvalidateSurface();
        }
    }

    public DualLineChartView()
    {
        PaintSurface += OnPaintSurface;
    }

    private void OnPaintSurface(object? sender, SKPaintSurfaceEventArgs e)
    {
        try
        {
            SKCanvas canvas = e.Surface.Canvas;
            canvas.Clear(SKColors.Transparent);

            // Verificar que tenemos datos
            if (_sensorData == null || _sensorData.Count == 0 || 
                _apiData == null || _apiData.Count == 0)
            {
                return;
            }

            int count = Math.Min(_sensorData.Count, _apiData.Count);
            if (count < 2) return;

            SKImageInfo info = e.Info;
            float width = info.Width;
            float height = info.Height;
            float leftPadding = 65;   // Para etiquetas Y
            float rightPadding = 15;
            float topPadding = 10;
            float bottomPadding = 40;  // Para etiquetas X
            float graphWidth = width - leftPadding - rightPadding;
            float graphHeight = height - topPadding - bottomPadding;

            if (graphWidth <= 0 || graphHeight <= 0) return;

            // Encontrar min/max
            double minValue = Math.Min(_sensorData.Min(), _apiData.Min());
            double maxValue = Math.Max(_sensorData.Max(), _apiData.Max());
            double range = maxValue - minValue;
            if (range == 0) range = 1;

            // Draw legend labels at the top
            // "Sensor" label (RED, left side)
            DrawLegendLabel(canvas, "Sensor", leftPadding + 5, topPadding + 10, SKColor.Parse("#FF0000"), isRightAligned: false);

            // "Clima" label (BLUE, right side)
            DrawLegendLabel(canvas, "Clima", leftPadding + graphWidth - 5, topPadding + 10, SKColor.Parse("#0000FF"), isRightAligned: true);

            // Draw Y-axis line
            using (var axisPaint = new SKPaint { Color = SKColors.DarkGray, StrokeWidth = 2 })
            {
                canvas.DrawLine(leftPadding, topPadding, leftPadding, topPadding + graphHeight, axisPaint);
            }

            // Draw X-axis line
            using (var axisPaint = new SKPaint { Color = SKColors.DarkGray, StrokeWidth = 2 })
            {
                canvas.DrawLine(leftPadding, topPadding + graphHeight, leftPadding + graphWidth, topPadding + graphHeight, axisPaint);
            }

            // Draw Y-axis labels (valores al costado)
            for (int i = 0; i <= 4; i++)
            {
                double value = minValue + (i * range) / 4;
                float y = topPadding + graphHeight - (i * graphHeight) / 4;
                string label = value.ToString("F1");

                // Dibujar pequeña línea tick
                using (var tickPaint = new SKPaint { Color = SKColors.DarkGray, StrokeWidth = 1 })
                {
                    canvas.DrawLine(leftPadding - 8, y, leftPadding, y, tickPaint);
                }

                // Dibujar número como pequeños rectángulos de caracteres (aproximación simple)
                DrawSimpleText(canvas, label, leftPadding - 12, y, isRightAligned: true);
            }

            // Draw X-axis labels (horas al fondo)
            int labelStep = Math.Max(1, count / 6);
            for (int i = 0; i < count; i += labelStep)
            {
                if (_labels != null && i < _labels.Count)
                {
                    float x = leftPadding + (i * graphWidth) / (count - 1);
                    float y = topPadding + graphHeight + 20;
                    DrawSimpleText(canvas, _labels[i], x, y, isCentered: true);
                }
            }

            // Draw horizontal grid lines (punteadas)
            using (var gridPaint = new SKPaint 
            { 
                Color = SKColors.Gray, 
                StrokeWidth = 0.5f, 
                IsAntialias = true,
                PathEffect = SKPathEffect.CreateDash(new float[] { 3, 3 }, 0)
            })
            {
                for (int i = 1; i < 4; i++)
                {
                    float y = topPadding + (i * graphHeight) / 4;
                    canvas.DrawLine(leftPadding, y, leftPadding + graphWidth, y, gridPaint);
                }
            }

            // Draw vertical grid lines
            using (var gridPaint = new SKPaint 
            { 
                Color = SKColors.Gray, 
                StrokeWidth = 0.3f, 
                IsAntialias = true,
                PathEffect = SKPathEffect.CreateDash(new float[] { 2, 2 }, 0)
            })
            {
                for (int i = 0; i < count; i += labelStep)
                {
                    float x = leftPadding + (i * graphWidth) / (count - 1);
                    canvas.DrawLine(x, topPadding, x, topPadding + graphHeight, gridPaint);
                }
            }

            // Draw sensor line (RED) - LÍNEA PUNTEADA
            using (var sensorPaint = new SKPaint 
            { 
                Color = SKColor.Parse("#FF0000"), 
                StrokeWidth = 5f, 
                IsAntialias = true, 
                Style = SKPaintStyle.Stroke, 
                StrokeCap = SKStrokeCap.Round,
                StrokeJoin = SKStrokeJoin.Round,
                PathEffect = SKPathEffect.CreateDash(new float[] { 8, 4 }, 0)  // Línea punteada
            })
            {
                SKPath sensorPath = new SKPath();
                for (int i = 0; i < count; i++)
                {
                    float x = leftPadding + (i * graphWidth) / (count - 1);
                    float y = topPadding + graphHeight - (float)((_sensorData[i] - minValue) / range * graphHeight);

                    if (i == 0)
                        sensorPath.MoveTo(x, y);
                    else
                        sensorPath.LineTo(x, y);
                }
                canvas.DrawPath(sensorPath, sensorPaint);
            }

            // Draw API line (BLUE) - LÍNEA CONTINUA
            using (var apiPaint = new SKPaint 
            { 
                Color = SKColor.Parse("#0000FF"), 
                StrokeWidth = 5f, 
                IsAntialias = true, 
                Style = SKPaintStyle.Stroke, 
                StrokeCap = SKStrokeCap.Round,
                StrokeJoin = SKStrokeJoin.Round
            })
            {
                SKPath apiPath = new SKPath();
                for (int i = 0; i < count; i++)
                {
                    float x = leftPadding + (i * graphWidth) / (count - 1);
                    float y = topPadding + graphHeight - (float)((_apiData[i] - minValue) / range * graphHeight);

                    if (i == 0)
                        apiPath.MoveTo(x, y);
                    else
                        apiPath.LineTo(x, y);
                }
                canvas.DrawPath(apiPath, apiPaint);
            }

            // Draw sensor data points (RED CIRCLES - LARGER)
            using (var sensorPointPaint = new SKPaint 
            { 
                Color = SKColor.Parse("#FF0000"), 
                Style = SKPaintStyle.Fill,
                IsAntialias = true
            })
            {
                for (int i = 0; i < count; i++)
                {
                    float x = leftPadding + (i * graphWidth) / (count - 1);
                    float y = topPadding + graphHeight - (float)((_sensorData[i] - minValue) / range * graphHeight);
                    canvas.DrawCircle(x, y, 4f, sensorPointPaint);  // Más grande: 4f
                }
            }

            // Draw API data points (BLUE CIRCLES - LARGER)
            using (var apiPointPaint = new SKPaint 
            { 
                Color = SKColor.Parse("#0000FF"), 
                Style = SKPaintStyle.Fill,
                IsAntialias = true
            })
            {
                for (int i = 0; i < count; i++)
                {
                    float x = leftPadding + (i * graphWidth) / (count - 1);
                    float y = topPadding + graphHeight - (float)((_apiData[i] - minValue) / range * graphHeight);
                    canvas.DrawCircle(x, y, 4f, apiPointPaint);  // Más grande: 4f
                }
            }
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine($"Error en DualLineChartView: {ex.Message}");
        }
    }

    private void DrawLegendLabel(SKCanvas canvas, string text, float x, float y, SKColor color, bool isRightAligned = false)
    {
        // Draw colored box/line indicator
        using (var boxPaint = new SKPaint { Color = color, Style = SKPaintStyle.Fill, IsAntialias = true })
        {
            if (isRightAligned)
            {
                // Draw small box to the left of text
                canvas.DrawRect(SKRect.Create(x - 30, y - 5, 10, 10), boxPaint);
                // Draw text
                DrawSimpleText(canvas, text, x - 15, y + 3, isRightAligned: false);
            }
            else
            {
                // Draw small box to the left of text
                canvas.DrawRect(SKRect.Create(x, y - 5, 10, 10), boxPaint);
                // Draw text
                DrawSimpleText(canvas, text, x + 15, y + 3, isRightAligned: false);
            }
        }
    }

    private void DrawSimpleText(SKCanvas canvas, string text, float x, float y, bool isRightAligned = false, bool isCentered = false)
    {
        using (var textPaint = new SKPaint { Color = SKColors.LightGray, IsAntialias = true })
        {
            // Medida aproximada (cada carácter ~6px de ancho)
            float textWidth = text.Length * 6;
            float adjustedX = x;

            if (isRightAligned)
                adjustedX = x - textWidth;
            else if (isCentered)
                adjustedX = x - textWidth / 2;

            for (int i = 0; i < text.Length; i++)
            {
                DrawCharacter(canvas, text[i], adjustedX + i * 6, y, textPaint);
            }
        }
    }

    private void DrawCharacter(SKCanvas canvas, char c, float x, float y, SKPaint paint)
    {
        // Dibuja un carácter simple usando líneas
        // Esta es una aproximación muy básica

        float size = 3;

        switch (c)
        {
            case '0':
            case '1':
            case '2':
            case '3':
            case '4':
            case '5':
            case '6':
            case '7':
            case '8':
            case '9':
            case '.':
            case '-':
                // Para números y símbolos simples, dibuja rectángulos pequeños
                using (var charPaint = new SKPaint { Color = SKColors.LightGray, Style = SKPaintStyle.Fill, IsAntialias = true })
                {
                    canvas.DrawRect(SKRect.Create(x, y - 5, 3, 3), charPaint);
                }
                break;
            case ':':
                using (var charPaint = new SKPaint { Color = SKColors.LightGray, Style = SKPaintStyle.Fill, IsAntialias = true })
                {
                    canvas.DrawCircle(x + 1, y - 3, 1, charPaint);
                    canvas.DrawCircle(x + 1, y + 1, 1, charPaint);
                }
                break;
            case 'S':
            case 'e':
            case 'n':
            case 's':
            case 'o':
            case 'r':
            case 'C':
            case 'l':
            case 'i':
            case 'm':
            case 'a':
                // Para letras, dibuja un pequeño rectángulo como representación aproximada
                using (var charPaint = new SKPaint { Color = SKColors.LightGray, Style = SKPaintStyle.Fill, IsAntialias = true })
                {
                    canvas.DrawRect(SKRect.Create(x, y - 6, 4, 8), charPaint);
                }
                break;
        }
    }
}
