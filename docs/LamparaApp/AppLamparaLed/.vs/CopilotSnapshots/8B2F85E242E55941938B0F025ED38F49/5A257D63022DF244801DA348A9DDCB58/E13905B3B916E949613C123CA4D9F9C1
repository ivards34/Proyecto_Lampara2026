using SkiaSharp;
using SkiaSharp.Views.Maui;
using SkiaSharp.Views.Maui.Controls;

namespace AppLamparaLed.Controls;

public class DualLineChartView : SKCanvasView
{
    public static readonly BindableProperty SensorDataProperty =
        BindableProperty.Create(nameof(SensorData), typeof(List<double>), typeof(DualLineChartView),
            new List<double>(), propertyChanged: (b, o, n) => ((DualLineChartView)b).InvalidateSurface());

    public static readonly BindableProperty ApiDataProperty =
        BindableProperty.Create(nameof(ApiData), typeof(List<double>), typeof(DualLineChartView),
            new List<double>(), propertyChanged: (b, o, n) => ((DualLineChartView)b).InvalidateSurface());

    public static readonly BindableProperty LabelsProperty =
        BindableProperty.Create(nameof(Labels), typeof(List<string>), typeof(DualLineChartView),
            new List<string>(), propertyChanged: (b, o, n) => ((DualLineChartView)b).InvalidateSurface());

    public List<double> SensorData
    {
        get => (List<double>)GetValue(SensorDataProperty);
        set => SetValue(SensorDataProperty, value);
    }

    public List<double> ApiData
    {
        get => (List<double>)GetValue(ApiDataProperty);
        set => SetValue(ApiDataProperty, value);
    }

    public List<string> Labels
    {
        get => (List<string>)GetValue(LabelsProperty);
        set => SetValue(LabelsProperty, value);
    }

    public DualLineChartView()
    {
        PaintSurface += OnPaintSurface;
    }

    private void OnPaintSurface(object? sender, SKPaintSurfaceEventArgs e)
    {
        SKCanvas canvas = e.Surface.Canvas;
        canvas.Clear(SKColors.Transparent);

        if (SensorData == null || SensorData.Count == 0 || ApiData == null || ApiData.Count == 0)
            return;

        int count = Math.Min(SensorData.Count, ApiData.Count);
        if (count < 2) return;

        SKImageInfo info = e.Info;
        float width = info.Width;
        float height = info.Height;
        float leftPadding = 50;  // Más espacio para etiquetas Y
        float rightPadding = 10;
        float topPadding = 10;
        float bottomPadding = 20;
        float graphWidth = width - leftPadding - rightPadding;
        float graphHeight = height - topPadding - bottomPadding;

        // Find min/max values for scaling
        double minValue = Math.Min(SensorData.Min(), ApiData.Min());
        double maxValue = Math.Max(SensorData.Max(), ApiData.Max());
        double range = maxValue - minValue;
        if (range == 0) range = 1;

        // Draw Y-axis labels (valores al costado)
        using (var labelPaint = new SKPaint 
        { 
            Color = SKColors.LightGray, 
            TextSize = 11, 
            IsAntialias = true,
            TextAlign = SKTextAlign.Right
        })
        {
            for (int i = 0; i <= 4; i++)
            {
                double value = minValue + (i * range) / 4;
                float y = topPadding + graphHeight - (i * graphHeight) / 4;
                string label = value.ToString("F1");
                canvas.DrawText(label, leftPadding - 8, y + 4, labelPaint);
            }
        }

        // Draw Y-axis line
        using (var axisPaint = new SKPaint { Color = SKColors.DarkGray, StrokeWidth = 1 })
        {
            canvas.DrawLine(leftPadding, topPadding, leftPadding, topPadding + graphHeight, axisPaint);
        }

        // Draw grid lines
        using (var gridPaint = new SKPaint { Color = SKColors.Gray, StrokeWidth = 0.5f, IsAntialias = true, PathEffect = SKPathEffect.CreateDash(new float[] { 2, 2 }, 0) })
        {
            // Horizontal grid lines
            for (int i = 0; i <= 4; i++)
            {
                float y = topPadding + (i * graphHeight) / 4;
                canvas.DrawLine(leftPadding, y, leftPadding + graphWidth, y, gridPaint);
            }
        }

        // Draw sensor line (red) - más gruesa
        using (var sensorPaint = new SKPaint 
        { 
            Color = SKColor.Parse("#FF0000"), 
            StrokeWidth = 4, 
            IsAntialias = true, 
            Style = SKPaintStyle.Stroke, 
            StrokeCap = SKStrokeCap.Round,
            StrokeJoin = SKStrokeJoin.Round
        })
        {
            SKPath sensorPath = new SKPath();
            for (int i = 0; i < count; i++)
            {
                float x = leftPadding + (i * graphWidth) / (count - 1);
                float y = topPadding + graphHeight - (float)((SensorData[i] - minValue) / range * graphHeight);

                if (i == 0)
                    sensorPath.MoveTo(x, y);
                else
                    sensorPath.LineTo(x, y);
            }
            canvas.DrawPath(sensorPath, sensorPaint);
        }

        // Draw API line (blue) - más gruesa
        using (var apiPaint = new SKPaint 
        { 
            Color = SKColor.Parse("#0000FF"), 
            StrokeWidth = 4, 
            IsAntialias = true, 
            Style = SKPaintStyle.Stroke, 
            StrokeCap = SKStrokeCap.Round,
            StrokeJoin = SKStrokeJoin.Round
        })
        {
            SKPath apiPath = new SKPath();
            for (int i = 0; i < count; i++)
            {
                float x = leftPadding + (i * graphWidth) / (count - 1);
                float y = topPadding + graphHeight - (float)((ApiData[i] - minValue) / range * graphHeight);

                if (i == 0)
                    apiPath.MoveTo(x, y);
                else
                    apiPath.LineTo(x, y);
            }
            canvas.DrawPath(apiPath, apiPaint);
        }
    }
}
