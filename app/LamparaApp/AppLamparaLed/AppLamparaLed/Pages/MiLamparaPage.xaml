<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pageModels="clr-namespace:AppLamparaLed.PageModels"
             xmlns:converters="clr-namespace:AppLamparaLed.Converters"
             x:Class="AppLamparaLed.Pages.MiLamparaPage"
             x:DataType="pageModels:MiLamparaPageModel"
             Title="Mi Lámpara">

    <Grid>
        <ScrollView>
            <VerticalStackLayout Padding="20" Spacing="20">

                    <!-- Ambient Data Section -->
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Datos Ambiente" FontSize="16" FontAttributes="Bold"/>
                        <Grid ColumnSpacing="10" RowSpacing="10" ColumnDefinitions="*,*" RowDefinitions="Auto">
                            <Border Grid.Column="0" Grid.Row="0" StrokeShape="RoundRectangle 10" Padding="15" Background="{AppThemeBinding Light={StaticResource LightSecondaryBackground},Dark={StaticResource DarkSecondaryBackground}}">
                                <VerticalStackLayout Spacing="5">
                                    <Label Text="Temperatura Ambiente" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource Gray500},Dark={StaticResource Gray400}}"/>
                                    <Label Text="{Binding AmbientTemperature, StringFormat='{0}°'}" FontSize="24" FontAttributes="Bold"/>
                                </VerticalStackLayout>
                            </Border>

                            <Border Grid.Column="1" Grid.Row="0" StrokeShape="RoundRectangle 10" Padding="15" Background="{AppThemeBinding Light={StaticResource LightSecondaryBackground},Dark={StaticResource DarkSecondaryBackground}}">
                                <VerticalStackLayout Spacing="5">
                                    <Label Text="Humedad Ambiente" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource Gray500},Dark={StaticResource Gray400}}"/>
                                    <Label Text="{Binding AmbientHumidity, StringFormat='{0}%'}" FontSize="24" FontAttributes="Bold"/>
                                </VerticalStackLayout>
                            </Border>
                        </Grid>
                    </VerticalStackLayout>

                    <!-- Climate Data Section -->
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Datos Clima" FontSize="16" FontAttributes="Bold"/>
                        <Grid ColumnSpacing="10" RowSpacing="10" ColumnDefinitions="*,*" RowDefinitions="Auto">
                            <Border Grid.Column="0" Grid.Row="0" StrokeShape="RoundRectangle 10" Padding="15" Background="{AppThemeBinding Light={StaticResource LightSecondaryBackground},Dark={StaticResource DarkSecondaryBackground}}">
                                <VerticalStackLayout Spacing="5">
                                    <Label Text="Temperatura Clima" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource Gray500},Dark={StaticResource Gray400}}"/>
                                    <Label Text="{Binding ClimateTemperature, StringFormat='{0}°'}" FontSize="24" FontAttributes="Bold"/>
                                </VerticalStackLayout>
                            </Border>

                            <Border Grid.Column="1" Grid.Row="0" StrokeShape="RoundRectangle 10" Padding="15" Background="{AppThemeBinding Light={StaticResource LightSecondaryBackground},Dark={StaticResource DarkSecondaryBackground}}">
                                <VerticalStackLayout Spacing="5">
                                    <Label Text="Humedad Clima" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource Gray500},Dark={StaticResource Gray400}}"/>
                                    <Label Text="{Binding ClimateHumidity, StringFormat='{0}%'}" FontSize="24" FontAttributes="Bold"/>
                                </VerticalStackLayout>
                            </Border>
                        </Grid>
                    </VerticalStackLayout>

                <!-- Lamp States -->
                <VerticalStackLayout Spacing="10">
                    <Label Text="Estado de la Lámpara" FontSize="16" FontAttributes="Bold"/>
                    <Button Text="Full" 
                            Command="{Binding SelectStateCommand}" 
                            CommandParameter="Full" 
                            Margin="0,5" 
                            HeightRequest="50"
                            BackgroundColor="{Binding IsFullSelected, Converter={StaticResource BoolToColorConverter}}"/>
                    <Button Text="Luz Tenue" 
                            Command="{Binding SelectStateCommand}" 
                            CommandParameter="Luz Tenue" 
                            Margin="0,5" 
                            HeightRequest="50"
                            BackgroundColor="{Binding IsLuzTenueSelected, Converter={StaticResource BoolToColorConverter}}"/>
                    <Button Text="Apagado" 
                            Command="{Binding SelectStateCommand}" 
                            CommandParameter="Apagado" 
                            Margin="0,5" 
                            HeightRequest="50"
                            BackgroundColor="{Binding IsApagadoSelected, Converter={StaticResource BoolToColorConverter}}"/>
                    <Button Text="Lámpara Temperatura" 
                            Command="{Binding SelectStateCommand}" 
                            CommandParameter="Lámpara Temperatura" 
                            Margin="0,5" 
                            HeightRequest="50"
                            BackgroundColor="{Binding IsLamparaTemperaturaSelected, Converter={StaticResource BoolToColorConverter}}"/>
                </VerticalStackLayout>

                <!-- Ver Histórico Button -->
                <Button Text="Ver histórico"
                        Command="{Binding NavigateToHistoricoCommand}"
                        Margin="0,20,0,0"
                        HeightRequest="50"
                        FontSize="16"
                        FontAttributes="Bold"/>

                <!-- Actualizar Button -->
                <Button Text="Actualizar datos"
                        Command="{Binding RefreshCommand}"
                        Margin="0,10,0,0"
                        HeightRequest="50"
                        FontSize="16"
                        FontAttributes="Bold"/>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Loading Indicator -->
        <ActivityIndicator IsRunning="{Binding IsLoading}"
                           IsVisible="{Binding IsLoading}"
                           Color="{StaticResource Primary}"
                           VerticalOptions="Center"
                           HorizontalOptions="Center"/>
    </Grid>

</ContentPage>
