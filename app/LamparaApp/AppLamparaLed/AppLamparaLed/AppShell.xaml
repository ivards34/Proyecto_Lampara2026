<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="AppLamparaLed.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:sf="clr-namespace:Syncfusion.Maui.Toolkit.SegmentedControl;assembly=Syncfusion.Maui.Toolkit"
    xmlns:pages="clr-namespace:AppLamparaLed.Pages"
    Shell.FlyoutBehavior="Flyout"
    Title="AppLamparaLed">

    <FlyoutItem Title="Mi Lámpara" Icon="{StaticResource IconDashboard}">
        <ShellContent ContentTemplate="{DataTemplate pages:MiLamparaPage}" Route="milampara" />
    </FlyoutItem>

    <FlyoutItem Title="Histórico" Icon="{StaticResource IconProjects}">
        <ShellContent ContentTemplate="{DataTemplate pages:HistoricoPage}" Route="historico" />
    </FlyoutItem>

    <Shell.FlyoutFooter>
        <Grid Padding="15">
            <sf:SfSegmentedControl x:Name="ThemeSegmentedControl"
                VerticalOptions="Center" HorizontalOptions="Center" SelectionChanged="SfSegmentedControl_SelectionChanged"
                SegmentWidth="40" SegmentHeight="40">
                <sf:SfSegmentedControl.ItemsSource>
                    <x:Array Type="{x:Type sf:SfSegmentItem}">
                        <sf:SfSegmentItem ImageSource="{StaticResource IconLight}" SemanticProperties.Description="Light mode"/>
                        <sf:SfSegmentItem ImageSource="{StaticResource IconDark}" SemanticProperties.Description="Dark mode"/>
                    </x:Array>
                </sf:SfSegmentedControl.ItemsSource>
            </sf:SfSegmentedControl>
        </Grid>
    </Shell.FlyoutFooter>

</Shell>
